/*
  X-Content-Type-Options: nosniff

# HTML pages — never cache, always fetch fresh from edge
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/about
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/contact
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/portfolio
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/services
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/privacy-policy
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/terms-of-service
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/cancellation-policy
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# Static assets — immutable, cache forever (hashed filenames)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
