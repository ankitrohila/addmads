# AddMads — Vercel edge cache headers
# Static assets: cached permanently (Next.js appends a content hash to filenames)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons and PWA icons
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Portfolio screenshots
/portfolio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# GSC verification file — keep accessible but do not cache aggressively
/googlea828cdcaf9d0e003.html
  Cache-Control: public, max-age=3600

# llms.txt — LLM crawlers fetch this; keep fresh
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# HTML pages — cache at CDN edge; Vercel revalidates in background
# s-maxage controls CDN TTL; stale-while-revalidate lets edge serve cached
# copies while fetching fresh in the background (no cold-origin latency)
/
  Cache-Control: public, s-maxage=300, stale-while-revalidate=3600

/about
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/services
  Cache-Control: public, s-maxage=600, stale-while-revalidate=3600

/services/*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/blog
  Cache-Control: public, s-maxage=300, stale-while-revalidate=3600

/blog/*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/portfolio
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/contact
  Cache-Control: public, s-maxage=300, stale-while-revalidate=3600

/location/*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/privacy-policy
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800

/terms-of-service
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800

/refund-policy
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800

/cancellation-policy
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800

/shipping-delivery-policy
  Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
