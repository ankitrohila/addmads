# ─── reCAPTCHA (lead form spam protection) ──────────────────────────────────
# Public reCAPTCHA v2 site key (exposed to browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# reCAPTCHA secret key — server-side verification in /api/lead
# Google reCAPTCHA admin → https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=

# ─── Zoho CRM (where leads land) ────────────────────────────────────────────
# Web-to-Lead security tokens.
# Zoho CRM → Setup → Developer Space → Webforms → your form → Security tokens.
# If /api/lead has no tokens it refuses to post rather than sending leads
# to an unauthenticated endpoint, so both must be set.
ZOHO_XNQSJSDP=
ZOHO_XMIWTLD=

# ─── Resend (customer confirmation email) ───────────────────────────────────
# Without RESEND_API_KEY no auto-reply is ever sent — the lead still reaches
# Zoho, but the customer gets nothing back and never sees the case-study links.
# Get the key at https://resend.com/api-keys
# NOTE: the sending domain in AUTOREPLY_FROM must be verified in Resend first
# (Resend → Domains → Add Domain → add the DNS records to Cloudflare), or every
# send is rejected even with a valid key.
RESEND_API_KEY=
AUTOREPLY_FROM="AddMads <hello@addmads.com>"
AUTOREPLY_REPLY_TO=theaddmads@gmail.com

# ─── Instagram (footer reel feed) ───────────────────────────────────────────
# Long-lived token for the Instagram API with Instagram Login
# (graph.instagram.com). The Basic Display API this replaced was shut down in
# December 2024, so an old Basic Display token will not work.
#
# The account must be a Business or Creator account, and the token needs the
# instagram_business_basic scope. Tokens last 60 days.
#
#   developers.facebook.com → your app → Instagram → API setup with Instagram
#   login → Generate access tokens
#
# Check the live state any time at /api/instagram?debug=1 — it reports the
# failure reason and how many days the current token has left.
INSTAGRAM_TOKEN=
